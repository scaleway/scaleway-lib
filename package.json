{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "preinstall": "git config --local include.path $PWD/.gitconfig",
    "lint:catalog": "pnpm check-catalog-usage",
    "lint": "oxlint",
    "lint:fix": "pnpm lint:fix -- --fix",
    "build": "pnpm pipeline build --full",
    "typecheck": "pnpm pipeline typecheck --full",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:unit": "pnpm pipeline test:unit --full",
    "test:unit:coverage": "pnpm pipeline test:unit:coverage --full",
    "test:types": "pnpm pipeline test:types --full",
    "release": "pnpm changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@manypkg/cli": "catalog:",
    "@rudderstack/analytics-js": "catalog:",
    "@scaleway/changesets-renovate": "workspace:*",
    "@scaleway/npm-trust": "workspace:*",
    "@scaleway/oxfmt-config": "workspace:*",
    "@scaleway/oxlint-config": "workspace:*",
    "@scaleway/tsconfig": "workspace:*",
    "@scaleway/utils": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@typescript/native-preview": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "browserslist": "catalog:",
    "chalk": "catalog:",
    "happy-dom": "catalog:",
    "jsdom": "catalog:",
    "lint-staged": "catalog:",
    "memfs": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pkg-pr-new": "catalog:",
    "publint": "catalog:",
    "read-pkg": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-localstorage-mock": "catalog:"
  },
  "lint-staged": {
    "*.ts?(x)": [
      "pnpm run format",
      "pnpm run lint --quiet"
    ],
    "*.y?(a)ml": [
      "pnpm run format"
    ],
    "*.json?(c)": [
      "pnpm run format"
    ],
    "*.mdx": [
      "pnpm run format"
    ],
    "(*package).json": [
      "pnpm exec manypkg check"
    ],
    "(*pnpm)-lock": [
      "pnpm exec manypkg check"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.12.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.x || 25.x || 26.x",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "24.x || 25.x || 26.x",
    "pnpm": ">=12.12.0"
  },
  "packageManager": "pnpm@12.12.0",
  "manypkg": {
    "ignoredRules": [
      "INTERNAL_MISMATCH"
    ]
  }
}
