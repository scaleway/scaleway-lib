{
  "name": "@scaleway/utility-types",
  "version": "0.0.0",
  "description": "A set of shared TypeScript utility types used across Scaleway projects",
  "keywords": [
    "shared-types",
    "types",
    "typescript",
    "utility-types"
  ],
  "homepage": "https://github.com/scaleway/scaleway-lib/tree/main/packages/utility-types",
  "bugs": {
    "url": "https://github.com/scaleway/scaleway-lib/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaleway/scaleway-lib.git",
    "directory": "packages/utility-types"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "test:unit": "vitest --run",
    "test:unit:coverage": "pnpm test:unit --coverage"
  },
  "engines": {
    "node": "24.x || 25.x || 26.x"
  }
}
