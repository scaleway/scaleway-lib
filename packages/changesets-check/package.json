{
  "name": "@scaleway/changesets-check",
  "version": "1.0.0",
  "description": "Check that changesets are present and valid",
  "keywords": [
    "changesets",
    "check",
    "ci"
  ],
  "homepage": "https://github.com/scaleway/scaleway-lib/tree/main/packages/changesets-check",
  "bugs": {
    "url": "https://github.com/scaleway/scaleway-lib/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaleway/scaleway-lib.git",
    "directory": "packages/changesets-check"
  },
  "bin": {
    "changesets-check": "dist/index.mjs"
  },
  "files": [
