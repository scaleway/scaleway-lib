{
  "name": "@scaleway/oxlint-config",
  "version": "1.1.0",
  "description": "Scaleway's shareable configuration for oxlint",
  "keywords": [
    "config",
    "lint",
    "oxlint",
    "oxlint-config",
    "scaleway"
  ],
  "homepage": "https://github.com/scaleway/scaleway-lib/tree/main/packages/oxlint-config",
  "bugs": {
    "url": "https://github.com/scaleway/scaleway-lib/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scaleway/scaleway-lib.git",
    "directory": "packages/oxlint-config"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "build:profile": "npx vite-bundle-visualizer -c vite.config.ts"
  },
  "devDependencies": {
    "oxlint": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.78.0"
  }
}
